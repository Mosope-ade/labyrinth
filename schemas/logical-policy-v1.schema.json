        }
      },
      "type": "object"
    },
    "preferred_roots": {
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
          "$ref": "#/$defs/DeviceId"
        }
      },
      "type": "object"
    },
    "routing_limits": {
      "$ref": "#/$defs/RoutingLimits",
      "default": {
        "max_paths_per_demand": 64,
        "max_search_states": 100000,
        "timeout_ms": 15000
      }
    }
  },
  "title": "LogicalPolicy",
  "type": "object"
}
