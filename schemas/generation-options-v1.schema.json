{
  "$defs": {
    "AddressingPolicy": {
      "additionalProperties": false,
      "description": "Defaults for the first blueprint, supplied explicitly to topology planning.",
      "properties": {
        "allocate_loopbacks": {
          "type": "boolean"
        },
        "redundant_gateway_reservations": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "single_gateway_reservations": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "transit_prefix_len": {
          "format": "uint8",
          "maximum": 31,
          "minimum": 0,
          "type": "integer"
        },
        "vlans": {
          "$ref": "#/$defs/VlanPolicy"
        }
      },
      "required": [
        "single_gateway_reservations",
        "redundant_gateway_reservations",
        "transit_prefix_len",
        "allocate_loopbacks",
        "vlans"
      ],
      "type": "object"
    },
    "DeviceId": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "LogicalPolicy": {
      "additionalProperties": false,
      "properties": {
        "preferred_owners": {
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/DeviceId"
            }
          },
          "type": "object"
        },
        "preferred_roots": {
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/DeviceId"
            }
          },
          "type": "object"
        },
        "routing_limits": {
          "$ref": "#/$defs/RoutingLimits",
          "default": {
            "max_paths_per_demand": 64,
            "max_search_states": 100000,
            "timeout_ms": 15000
          }
        }
      },
      "type": "object"
    },
    "RoutingLimits": {
      "additionalProperties": false,
      "properties": {
        "max_paths_per_demand": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_search_states": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_search_states",
        "max_paths_per_demand",
        "timeout_ms"
      ],
      "type": "object"
    },
    "VerificationLimits": {
      "additionalProperties": false,
      "properties": {
        "max_scenarios": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_service_classes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_scenarios",
        "max_service_classes"
      ],
      "type": "object"
    },
    "VlanPolicy": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "first": {
          "format": "uint16",
          "maximum": 4094,
          "minimum": 1,
          "type": "integer"
        },
        "last": {
          "format": "uint16",
          "maximum": 4094,
          "minimum": 1,
          "type": "integer"
        },
        "reuse_across_sites": {
          "type": "boolean"
        }
      },
      "required": [
        "first",
        "last",
        "excluded",
        "reuse_across_sites"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "addressing": {
      "$ref": "#/$defs/AddressingPolicy"
    },
    "logical": {
      "$ref": "#/$defs/LogicalPolicy"
    },
    "selection_search_states": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "verification": {
      "$ref": "#/$defs/VerificationLimits"
    }
  },
  "required": [
    "addressing",
    "logical",
    "verification",
    "selection_search_states"
  ],
  "title": "GenerationOptions",
  "type": "object"
}
