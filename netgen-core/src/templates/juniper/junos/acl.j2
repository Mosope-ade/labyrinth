firewall {
    filter {{ filter_name }} {
        term MATCH {
{% if from_subnet and to_subnet %}
            from {
                source-address {{ from_subnet }};
                destination-address {{ to_subnet }};
            }
{% elif from_subnet %}
            from {
                source-address {{ from_subnet }};
            }
{% elif to_subnet %}
            from {
                destination-address {{ to_subnet }};
            }
{% endif %}
            then {{ action }};
        }
        term DENY-ALL {
            then {
                discard;
                log;
                syslog;
            }
        }
    }
}
