      "type": "string"
    },
    "RoutingLimits": {
      "additionalProperties": false,
      "properties": {
        "max_paths_per_demand": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_search_states": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_search_states",
        "max_paths_per_demand",
        "timeout_ms"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "preferred_owners": {
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
