interfaces {
{% for iface in interfaces %}
    {{ iface.name }} {
        description "{{ iface.description }}";
        unit 0 {
            family inet {
{% if iface.ipv4_cidr %}
                address {{ iface.ipv4_cidr }};
{% endif %}
            }
{% if iface.ipv6_cidr %}
            family inet6 {
                address {{ iface.ipv6_cidr }};
            }
{% endif %}
        }
    }
{% endfor %}
}
