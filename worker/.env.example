# Required explicit initial policy. No dotenv autoload; inject via runtime secrets.
LABYRINTH_DATABASE_URL=
LABYRINTH_STORAGE_ORIGIN=https://PROJECT.supabase.co
LABYRINTH_STORAGE_BUCKET=engineering-packages
LABYRINTH_STORAGE_TOKEN=
LABYRINTH_WORKER_ID=worker-1
LABYRINTH_PRLIMIT_PATH=/usr/bin/prlimit
LABYRINTH_WORKER_LEASE_SECS=60
LABYRINTH_WORKER_HEARTBEAT_SECS=15
LABYRINTH_WORKER_DEADLINE_SECS=120
LABYRINTH_WORKER_CPU_SECS=60
LABYRINTH_WORKER_MEMORY_BYTES=1073741824
LABYRINTH_WORKER_INPUT_BYTES=2097152
LABYRINTH_WORKER_OUTPUT_BYTES=33554432
LABYRINTH_WORKER_ATTEMPTS=3
LABYRINTH_WORKER_RETRY_FIRST_SECS=10
LABYRINTH_WORKER_RETRY_SECOND_SECS=60
