# EXAMPLE ONLY: export through your environment/secret manager; the server does not
# load .env files. Keep local secrets out of git.
LABYRINTH_BIND=127.0.0.1:3000
# On Render bind 0.0.0.0 at the assigned service port, behind its HTTPS ingress.
LABYRINTH_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# Restricted runtime LOGIN with only labyrinth_api membership; never postgres/service admin.
# Hosted TCP connections require valid TLS certificates and hostnames.
LABYRINTH_DATABASE_URL=
# Illustrative development limits, not benchmarked production SLOs. All are required.
LABYRINTH_DB_MAX_CONNECTIONS=4
LABYRINTH_DB_ACQUIRE_TIMEOUT_MS=1000
LABYRINTH_DB_STATEMENT_TIMEOUT_MS=5000
LABYRINTH_DB_LOCK_TIMEOUT_MS=1000
LABYRINTH_HTTP_MAX_IN_FLIGHT=16
LABYRINTH_HTTP_TIMEOUT_MS=10000

# Optional as a complete group; absent group disables artifact transport (503).
# Modern publishable key + dedicated reader Auth email/password; no service-role key.
# LABYRINTH_ARTIFACT_STORAGE_ORIGIN=https://PROJECT.supabase.co
# LABYRINTH_ARTIFACT_STORAGE_BUCKET=engineering-packages
# LABYRINTH_ARTIFACT_STORAGE_API_KEY=
# LABYRINTH_ARTIFACT_STORAGE_EMAIL=
# LABYRINTH_ARTIFACT_STORAGE_PASSWORD=

# Optional mutation policy: required to enable project creation, no implicit default.
LABYRINTH_TENANT_MAX_PROJECTS=50

# Explicit personal-workspace onboarding; absent setting disables onboarding.
LABYRINTH_ONBOARDING_MAX_ACTIVE_JOBS=2
