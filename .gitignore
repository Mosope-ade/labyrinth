# Rust build outputs (keep Cargo.lock versioned)
target/
**/*.rs.bk

# Frontend dependencies, builds and caches
node_modules/
dist/
.vite/
.turbo/
*.tsbuildinfo

# Local environment and credentials (keep documented templates)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Local runtime data, logs and temporary files
/.local/
/tmp/
/logs/
*.log
*.pid
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Test and coverage outputs
/coverage/
/llvm-cov/
*.profraw
*.profdata
playwright-report/
test-results/

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Existing local-only notes
CLAUDE.md
NEWPLAN.md

# Deployment validation tooling caches
__pycache__/
*.pyc
