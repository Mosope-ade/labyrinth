
# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: gemini | anthropic | openai | custom
AI_PROVIDER=gemini

# Your API key for the selected provider.
AI_API_KEY=your-api-key-here

# Model to use. Defaults per provider if not set:
#   gemini    → gemini-2.0-flash
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o
AI_MODEL=gemini-2.0-flash

# Optional: override the base URL (required for AI_PROVIDER=custom).
# AI_BASE_URL=http://localhost:11434/v1

# Optional: max tokens per AI response (default: 4096)
# AI_MAX_TOKENS=4096

# ─── Server ───────────────────────────────────────────────────────────────────
# Use 'info' in production. 'debug' logs full request/response bodies.
RUST_LOG=netgen_api=info,tower_http=info

# Comma-separated list of allowed CORS origins. Defaults to localhost:3000.
# ALLOWED_ORIGINS=https://labyrinth.network,http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
# Never commit the real value. Server panics on startup if this is not set
# or if it equals the placeholder below.
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32

# ─── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:password@localhost:5432/labyrinth
