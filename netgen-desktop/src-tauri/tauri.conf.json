{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labyrinth",
  "version": "0.1.0",
  "identifier": "network.labyrinth",
  "build": {
    "beforeDevCommand": "cd ../../netgen-web && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd ../../netgen-web && npm run build",
    "frontendDist": "../../netgen-web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Labyrinth",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
